# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must stay LF everywhere, or bash fails on the carriage returns.
*.sh text eol=lf

# FBL fixtures are compared byte for byte (line endings, byte-order marks), so Git must never convert them.
specifications/fbl/fixtures/** -text
specifications/fbl/registrations/** -text

# The knowledge examples are read byte for byte by the knowledge-equivalence fixture, CRLF endings included.
definitions/designers/examples/** -text

# ATD conformance fixtures (spec 035, data-model.md section 8): the input files of a case and of a capability fixture
# are compared byte for byte, so Git never converts them; their JSON files stay text.
definitions/*/conformance/** -text
definitions/*/conformance/**/*.json text
specifications/atd/fixtures/** -text
specifications/atd/fixtures/**/*.json text
specifications/atd/capabilities/*/fixtures/** -text
specifications/atd/capabilities/*/fixtures/**/*.json text
# A case whose document is itself JSON keeps that document's bytes too (the Databricks pipeline's settings file, CRLF).
definitions/diagrams/conformance/databricks-pipeline/settings/pipeline.json -text
definitions/diagrams/conformance/databricks-pipeline/settings/after-*.json -text
