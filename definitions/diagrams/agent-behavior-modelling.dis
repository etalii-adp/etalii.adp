          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "'Try in order'"
            },
            "editable": false,
            "position": "top",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "position": "center",
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "doubleClick": "editLabel"
      },
      "Parallel": {
        "shape": "superellipse",
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
