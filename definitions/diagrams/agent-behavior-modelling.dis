{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.etalii.agent-behavior-modelling",
    "version": "0.1.0",
    "label": "Agent Behavior Modelling",
    "doc": {
      "summary": "A chat agent's instructions as a behavior tree: what it does in order, what it tries until something works, what it may do at once, where it asks first, and when it stops.",
      "description": "Agent Behavior Modelling borrows the behavior tree from game development and tunes it to agent engineering. A tree of nodes says how an agent works through a task: composites (Do in order, Try in order, Do together) arrange their children, wrappers (Retry up to N times, Repeat until, Only while, Ask approval before) govern exactly one child, and leaves (Check, Do, Ask the user, Delegate) are the work itself.\n\nThe tree is not stored in a model file of its own. It is a keyword-marked bullet list under the `Behavior` heading of an ordinary Markdown file, and that Markdown file is the instruction file the agent reads (a system prompt, an `AGENTS.md`, a skill). The `.adp` registration beside it keeps only what the drawing needs: positions the author dragged.\n\nOrigin tag: `etalii/agent-behavior-modelling`. What this specification cannot express - the Markdown format, the places used as ids, the computed layout with its overrides, the re-parenting gesture and the kind change refused for a node's children - is described in `agent-behavior-modelling.md` beside this file.",
      "rationale": "An instruction file written as prose hides its control flow: which steps are ordered, which are alternatives, where the agent must stop and ask. Drawn as a behavior tree, the flow is visible and checkable, while the file the agent reads stays plain Markdown.",
      "tags": [
        "agent",
        "behavior tree",
        "prompt",
        "instructions",
        "agent engineering",
        "humans and agents together"
      ],
      "audience": [
        "user",
        "author"
      ],
      "seeAlso": [
        {
          "title": "Behavior tree (artificial intelligence, robotics and control)",
          "href": "https://en.wikipedia.org/wiki/Behavior_tree_(artificial_intelligence,_robotics_and_control)"
        }
      ]
    },
    "defaultLocale": "en",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "license": "Apache-2.0",
    "icon": "mdi-robot-outline",
    "fileExtension": "md",
    "requires": {
      "conformance": "standard"
    }
  },
  "metamodel": {
    "doc": "Eleven node types in three families, nested to any depth. The tree is containment: every node but the root has exactly one parent, the order of a node's children is meaningful and stored, and the family decides how many children a node may hold.",
    "types": {
      "BehaviorNode": {
        "abstract": true,
        "doc": "Everything that can be placed in a behavior tree.",
        "labelAttribute": "label",
        "attributes": {
          "label": {
            "type": "string",
            "label": "Label",
            "default": "",
            "order": 1,
            "doc": {
              "summary": "What this node does, or the condition it names.",
              "description": "The text after the keyword on the node's list item. For Repeat until and Only while it is the condition; for Delegate it names the sub-agent or links another behavior file."
            }
          },
          "notes": {
            "type": "text",
            "label": "Notes",
            "markup": "markdown",
            "default": "",
            "order": 3,
            "doc": {
              "summary": "Further instructions for this node, kept as written.",
              "description": "The lines indented under the node's list item that are not list items themselves. The agent reads them with the node; the diagram marks a node that has them but never draws them."
            }
          }
        }
      },
      "Composite": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that arranges one or more children.",
        "children": {
          "allowed": [
            "BehaviorNode"
          ],
          "ordered": true,
          "min": 1
        }
      },
      "Decorator": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that governs exactly one child: when it runs, how often, or whether the user agrees first.",
        "children": {
          "allowed": [
            "BehaviorNode"
          ],
          "ordered": true,
          "min": 1,
          "max": 1
        }
      },
      "Leaf": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that does the work and holds no children."
      },
      "Sequence": {
        "extends": "Composite",
        "label": "Do in order",
        "icon": "mdi-format-list-numbered",
        "doc": "Runs the children one after another; stops and fails at the first that fails; succeeds when all have succeeded.",
        "x-abm": {
          "keyword": "Do in order",
          "kind": "sequence"
        }
      },
      "Fallback": {
        "extends": "Composite",
        "label": "Try in order",
        "icon": "mdi-call-split",
        "doc": "Tries the children one after another; stops and succeeds at the first that succeeds; fails when all have failed.",
        "x-abm": {
          "keyword": "Try in order",
          "kind": "fallback"
        }
      },
      "Parallel": {
        "extends": "Composite",
        "label": "Do together",
        "icon": "mdi-format-columns",
        "doc": "The children are independent and may run at once, as parallel tool calls or sub-agents; succeeds when all have succeeded.",
        "x-abm": {
          "keyword": "Do together",
          "kind": "parallel"
        }
      },
      "Retry": {
        "extends": "Decorator",
        "label": "Retry",
        "icon": "mdi-replay",
        "doc": "Runs the child again when it fails, at most the given number of attempts in total.",
        "attributes": {
          "attempts": {
            "type": "int",
            "label": "Attempts",
            "default": 3,
            "min": 1,
            "order": 2,
            "doc": "The N of `Retry up to N times`: the most attempts in total, the first included."
          }
        },
        "x-abm": {
          "keyword": "Retry up to {attempts} times",
          "kind": "retry"
        }
      },
      "RepeatUntil": {
        "extends": "Decorator",
        "label": "Repeat until",
        "icon": "mdi-repeat",
        "doc": "Runs the child again and again until the condition in the label holds: the agentic loop, such as working until the tests pass.",
        "x-abm": {
          "keyword": "Repeat until",
          "kind": "repeat"
        }
      },
      "Guard": {
        "extends": "Decorator",
        "label": "Only while",
        "icon": "mdi-shield-outline",
        "doc": "Runs the child only while the condition in the label holds, and abandons it when it stops holding.",
        "x-abm": {
          "keyword": "Only while",
          "kind": "guard"
        }
      },
      "Approval": {
        "extends": "Decorator",
        "label": "Ask approval before",
        "icon": "mdi-account-check-outline",
        "doc": "Describes what the child will do and waits for the user's explicit approval; when refused, the node fails.",
        "x-abm": {
          "keyword": "Ask approval before",
          "kind": "approval"
        }
      },
      "Check": {
        "extends": "Leaf",
        "label": "Check",
        "icon": "mdi-help-circle-outline",
        "doc": "A question answered from the conversation, memory or a tool result; succeeds when true, fails when false. Never acts.",
        "x-abm": {
          "keyword": "Check",
          "kind": "check"
        }
      },
      "Do": {
        "extends": "Leaf",
        "label": "Do",
        "icon": "mdi-play-outline",
        "doc": "One piece of work: a tool call, a written answer, an edit. Succeeds when done.",
        "x-abm": {
          "keyword": "Do",
          "kind": "action"
        }
      },
      "AskUser": {
        "extends": "Leaf",
        "label": "Ask the user",
        "icon": "mdi-account-question-outline",
        "doc": "Asks the question and waits for the answer; succeeds when answered.",
        "x-abm": {
          "keyword": "Ask the user",
          "kind": "ask"
        }
      },
      "Delegate": {
        "extends": "Leaf",
        "label": "Delegate",
        "icon": "mdi-account-arrow-right-outline",
        "doc": "Hands the task to a sub-agent or to another behavior file, linked in the label; succeeds when it reports success.",
        "x-abm": {
          "keyword": "Delegate",
          "kind": "delegate"
        }
      }
    },
    "relations": {
      "Child": {
        "label": "Child",
        "doc": {
          "summary": "The line from a node to each of its children, in order.",
          "description": "Not a stored relation: a line is derived from containment, one per node that has a parent. Drawing one from a node to another moves the second, with everything under it, under the first; removing one is not offered, because a node always has its place in the tree."
        },
        "source": [
          "Composite",
          "Decorator"
        ],
        "target": "BehaviorNode",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "acyclic": true,
        "derived": "diagram.nodes.filter(n, n.parent != null).map(n, {'source': n.parent, 'target': n})"
      }
    }
  },
  "coordinates": {
    "doc": "One free pixel canvas. Every position is computed by the tree layout unless the author dragged the node, in which case the dragged top-left is kept in the .adp registration.",
    "systems": {
      "canvas": {
        "kind": "cartesian",
        "x": {
          "kind": "linear",
          "unit": "px"
        },
        "y": {
          "kind": "linear",
          "unit": "px"
        },
        "orientation": "y-down",
        "grid": {
          "visible": false
        }
      }
    },
    "default": "canvas"
  },
  "notation": {
    "doc": "The family is the shape, as behavior tree editors in games draw it: a composite is a squircle, a wrapper a hexagon. Among the leaves a Check is a pill, a Do a box, an Ask the user a parallelogram and a Delegate a diode. Every node shows its keyword in small capitals above its label.",
    "theme": {
      "tokens": {
        "color.text": "#0f172a",
        "color.surface": "#ffffff",
        "color.border": "#e2e8f0",
        "color.abm.composite": "#aaed92",
        "color.abm.decorator": "#fcf281",
        "color.abm.check": "#9edcfa",
        "color.abm.action": "#86e6d9",
        "color.abm.other": "#ededed"
      },
      "modes": {
        "dark": {
          "color.text": "#f1f5f9",
          "color.surface": "#1e293b",
          "color.border": "#334155",
          "color.abm.composite": "#2e7814",
          "color.abm.decorator": "#736a03",
          "color.abm.check": "#086fa1",
          "color.abm.action": "#187569",
          "color.abm.other": "#696969"
        }
      },
      "defaultMode": "light",
      "followSystem": true,
      "doc": "The fills are the functional decomposition graph's, so the two etalii notations read alike in both themes."
    },
    "styles": {
      "node": {
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1.5
        },
        "font": {
          "size": 12,
          "color": {
            "token": "color.text"
          }
        },
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "composite": {
        "extends": "node",
        "fill": {
          "token": "color.abm.composite"
        }
      },
      "decorator": {
        "extends": "node",
        "fill": {
          "token": "color.abm.decorator"
        }
      },
      "check": {
        "extends": "node",
        "fill": {
          "token": "color.abm.check"
        }
      },
      "action": {
        "extends": "node",
        "fill": {
          "token": "color.abm.action"
        }
      },
      "other": {
        "extends": "node",
        "fill": {
          "token": "color.abm.other"
        }
      },
      "child": {
        "stroke": {
          "color": {
            "token": "color.text"
          },
          "width": 1.5
        }
      }
    },
    "shapes": {
      "superellipse": {
        "label": "Superellipse",
        "doc": "The squircle |x/a|^4 + |y/b|^4 = 1 inscribed in the bounds, written as four cubic Bezier quarters with control factor 0.919.",
        "path": {
          "segments": [
            {
              "op": "M",
              "x": "w",
              "y": "h * 0.5"
            },
            {
              "op": "C",
              "c1x": "w",
              "c1y": "h * 0.9595",
              "c2x": "w * 0.9595",
              "c2y": "h",
              "x": "w * 0.5",
              "y": "h"
            },
            {
              "op": "C",
              "c1x": "w * 0.0405",
              "c1y": "h",
              "c2x": 0,
              "c2y": "h * 0.9595",
              "x": 0,
              "y": "h * 0.5"
            },
            {
              "op": "C",
              "c1x": 0,
              "c1y": "h * 0.0405",
              "c2x": "w * 0.0405",
              "c2y": 0,
              "x": "w * 0.5",
              "y": 0
            },
            {
              "op": "C",
              "c1x": "w * 0.9595",
              "c1y": 0,
              "c2x": "w",
              "c2y": "h * 0.0405",
              "x": "w",
              "y": "h * 0.5"
            },
            {
              "op": "Z"
            }
          ]
        },
        "textArea": {
          "x": "w * 0.01 + 6",
          "y": "h * 0.15",
          "w": "w * 0.98 - 12",
          "h": "h * 0.7"
        }
      },
      "diode": {
        "label": "Diode",
        "doc": "Square on the left and round on the right: a rectangle closed on the right by a semicircle of radius r = min(h / 2, w).",
        "path": {
          "segments": [
            {
              "op": "M",
              "x": 0,
              "y": 0
            },
            {
              "op": "L",
              "x": "w - min(h / 2.0, w)",
              "y": 0
            },
            {
              "op": "A",
              "rx": "min(h / 2.0, w)",
              "ry": "min(h / 2.0, w)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": "w - min(h / 2.0, w)",
              "y": "h"
            },
            {
              "op": "L",
              "x": 0,
              "y": "h"
            },
            {
              "op": "Z"
            }
          ]
        },
        "textArea": {
          "x": 6,
          "y": "h * 0.15",
          "w": "w - 0.134 * min(h / 2.0, w) - 12",
          "h": "h * 0.7"
        }
      }
    },
    "nodes": {
      "Sequence": {
        "shape": "superellipse",
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "'Do in order'"
            },
            "editable": false,
            "position": "top",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "position": "center",
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "doubleClick": "editLabel",
        "doc": "Every node is 200 by 60 and shows its keyword on the top line and its label beneath it. Only the label is edited in place: the keyword is the node's type, changed in the property grid."
      },
      "Fallback": {
        "shape": "superellipse",
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
