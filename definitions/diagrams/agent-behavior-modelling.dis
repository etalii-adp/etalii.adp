            "type": "text",
            "label": "Notes",
            "markup": "markdown"
          }
        },
        "actions": [
          {
            "set": {
              "notes": "p.notes"
            }
          }
        ]
      }
    },
    "deletion": {
      "BehaviorNode": {
        "children": "delete",
        "relations": "delete",
        "doc": "Removing a node removes everything under it: its lines are cut from the Markdown together."
      }
    }
  },
  "constraints": {
    "doc": "A Markdown file edited by hand that breaks a rule still opens and draws; each breach is reported on the line it is on.",
    "blockSaveOn": "never",
    "builtIn": {
      "std.multiplicity": {
        "severity": "error"
      },
      "std.acyclic": {
        "severity": "error"
      }
    },
    "rules": [
      {
        "id": "leafWithChildren",
        "label": "Leaf with children",
        "scope": [
          "Leaf"
        ],
        "rule": "self.children.size() == 0",
        "severity": "error",
        "message": {
          "cel": "'A ' + self.type + ' node does the work itself and holds no children.'"
        },
        "doc": "Standalone rule id abm.leaf-with-children."
      },
      {
        "id": "decoratorChildren",
        "label": "Wrapper with other than one child",
        "scope": [
          "Decorator"
        ],
        "rule": "self.children.size() == 1",
        "severity": "error",
        "message": {
          "cel": "'A ' + self.type + ' node wraps exactly one child; this one has ' + string(self.children.size()) + '.'"
        },
        "doc": "Standalone rule id abm.decorator-children."
      },
      {
        "id": "emptyComposite",
        "label": "Composite without children",
        "scope": [
          "Composite"
        ],
        "rule": "self.children.size() > 0",
        "severity": "warning",
        "message": "This composite has no children, so it has nothing to arrange.",
        "doc": "Standalone rule id abm.empty-composite. A warning, because it is the natural state while a tree is being written."
      },
      {
        "id": "severalRoots",
        "label": "More than one root",
        "scope": "diagram",
        "rule": "diagram.nodes.filter(n, n.parent == null).size() <= 1",
        "severity": "warning",
        "message": "The behavior has more than one root; the agent reads them as if they were done in order.",
        "doc": "Standalone rule id abm.several-roots."
      },
      {
        "id": "noAttempts",
        "label": "Retry without attempts",
        "scope": [
          "Retry"
        ],
        "rule": "self.attempts >= 1",
        "severity": "error",
        "message": "A retry needs at least one attempt.",
        "doc": "Standalone rule id abm.no-attempts."
      },
      {
        "id": "reparentWithinTree",
        "kind": "containment",
        "when": "has(child.id)",
        "rule": "parent.id != child.id && !child.descendants().exists(d, d.id == parent.id)",
        "message": "A node cannot be moved under itself or under anything below it.",
        "doc": "The cycle rule the derived Child relation states, applied to the re-parenting gesture."
      }
    ]
  },
  "layout": {
    "algorithms": {
      "tree": {
        "algorithm": "plugin:net.etalii.adp.etalii.abmTreeLayout",
        "direction": "down",
        "spacing": {
          "node": 28,
          "layer": 56
        },
        "doc": "Top-down: the root at the top, each node's children left to right in document order beneath it, each subtree as wide as it needs. The algorithm is in agent-behavior-modelling.md."
      }
    },
    "default": "tree",
    "trigger": "always",
    "respect": "pinned",
    "animate": false,
    "doc": "The tree is laid out on every change. A node the author dragged is pinned: its height is kept in the .adp registration and moves its whole row and everything beneath it; across, the order decides."
  },
  "persistence": {
    "format": "plugin:net.etalii.adp.etalii.abmMarkdown",
    "encoding": "utf-8",
    "newline": "crlf",
    "files": {
      "mode": "single",
      "model": "{name}.md"
    },
    "ids": {
      "strategy": "derived",
      "stable": false,
      "doc": "A node's id is its place in the tree, written 1, 1.2, 1.2.1: its parent's place, a dot, and its position among its siblings counted from 1. Nothing is written into the Markdown to name it. The expression gives the last part; the runtime prefixes the parent's place (see agent-behavior-modelling.md).",
      "expression": "string(self.parent == null ? diagram.nodes.filter(n, n.parent == null).indexOf(self) + 1 : self.parent.children.indexOf(self) + 1)"
    },
    "ordering": {
      "elements": "tree"
    },
    "omitDefaults": true,
    "view": {
      "store": [
        "pinned",
        "bounds"
      ]
    },
    "definition": {
      "embed": "none"
    },
    "doc": "The tree is the first bullet list under the first Behavior heading of a Markdown file; everything else in the file is the author's and is kept byte for byte. Positions the author dragged live in the .adp registration's layout block, never in the Markdown. The format is in agent-behavior-modelling.md."
  },
  "plugins": {
    "net.etalii.adp.etalii.abmMarkdown": {
      "version": "^0.1.0",
      "provides": [
        "persistenceFormat"
      ],
      "required": true,
      "doc": "Reads the behavior tree from a Markdown file's Behavior section and edits it line by line, so every other byte of the file survives."
    },
    "net.etalii.adp.etalii.abmTreeLayout": {
      "version": "^0.1.0",
      "provides": [
        "layout"
      ],
      "required": false,
      "fallback": {
        "layout": "mrtree"
      },
      "doc": "The top-down tree layout, with dragged positions from the registration applied over it."
    },
    "net.etalii.adp.etalii.abmReorder": {
      "version": "^0.1.0",
      "provides": [
        "action"
      ],
      "required": true,
      "doc": "Moves a node earlier or later among its siblings by moving its lines in the Markdown."
    }
  },
  "x-adp": {
    "origin": "etalii/agent-behavior-modelling",
    "kind": "Diagram",
