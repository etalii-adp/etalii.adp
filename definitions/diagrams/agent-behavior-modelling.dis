      "moveEarlier": {
        "label": "Move earlier",
        "for": [
          "BehaviorNode"
        ],
        "shortcut": "Alt+ArrowUp",
        "enabled": "self.parent != null && self.parent.children[0].id != self.id",
        "doc": "Swaps the node, with everything under it, with the sibling before it. Reordering moves lines in the Markdown.",
        "plugin": {
          "name": "net.etalii.adp.etalii.abmReorder"
        }
      },
      "moveLater": {
        "label": "Move later",
        "for": [
          "BehaviorNode"
        ],
        "shortcut": "Alt+ArrowDown",
        "enabled": "self.parent != null && self.parent.children[self.parent.children.size() - 1].id != self.id",
        "doc": "Swaps the node, with everything under it, with the sibling after it.",
        "plugin": {
          "name": "net.etalii.adp.etalii.abmReorder"
        }
      },
      "editNotes": {
        "label": "Notes",
        "for": [
          "BehaviorNode"
        ],
        "icon": "mdi-note-text-outline",
        "params": {
