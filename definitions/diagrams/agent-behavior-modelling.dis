      "AskUser": {
        "shape": {
          "type": "parallelogram",
          "params": {
            "skew": 0.2,
            "direction": "right"
          }
        },
        "style": "other",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "'Ask the user'"
            },
            "editable": false,
            "position": "top",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "position": "center",
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "doubleClick": "editLabel"
      },
      "Delegate": {
        "shape": "diode",
        "style": "other",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "'Delegate'"
            },
            "editable": false,
            "position": "top",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "position": "center",
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "doubleClick": "editLabel"
      }
    },
    "edges": {
      "Child": {
        "style": "child",
        "line": {
          "routing": "orthogonal",
          "bendpoints": {
            "editable": false
          }
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "deletable": false,
        "reconnectable": false,
        "doc": "An orthogonal line from the parent down to the child, with an arrowhead at the child."
      }
    }
  },
  "forms": {
    "node": {
      "for": "BehaviorNode",
      "usage": [
        "inspector"
      ],
      "label": "Behavior node",
      "items": [
        {
          "kind": "section",
          "title": "Node",
          "items": [
            {
              "kind": "computed",
              "label": "Kind",
              "value": {
                "cel": "self.type"
              },
              "doc": "Changed with the Kind choice the runtime offers; a kind that cannot hold the node's children is refused (see agent-behavior-modelling.md)."
            },
            {
              "attribute": "label"
            },
            {
              "attribute": "attempts",
              "visible": "self.type == 'Retry'"
            },
            {
              "attribute": "notes",
              "widget": "textarea",
              "rows": 4
            }
          ]
        },
        {
          "kind": "section",
          "title": "Model",
          "items": [
            {
              "kind": "computed",
              "label": "Place",
              "value": {
                "cel": "self.id"
              },
              "doc": "The node's place in the tree (1, 1.2, 1.2.1), which is also its id."
            }
          ]
        }
      ]
    }
  },
  "toolbox": {
    "doc": "One tool per kind, dropped where the node belongs: it goes under the nearest node above the drop that can take another child, or becomes the root of an empty tree. Parent lines are drawn on the canvas with a right-button drag, not from the toolbox.",
    "generic": {
      "select": true,
      "pan": true
    },
    "groups": [
      {
        "id": "composites",
        "label": "Composites",
        "tools": [
          {
            "id": "sequence",
            "kind": "operation",
            "operation": "addSequence",
            "label": "Do in order",
            "icon": "mdi-format-list-numbered",
            "doc": "Runs the children one after another; stops and fails at the first that fails; succeeds when all have succeeded."
          },
          {
            "id": "fallback",
            "kind": "operation",
            "operation": "addFallback",
            "label": "Try in order",
            "icon": "mdi-call-split",
            "doc": "Tries the children one after another; stops and succeeds at the first that succeeds; fails when all have failed."
          },
          {
            "id": "parallel",
            "kind": "operation",
            "operation": "addParallel",
            "label": "Do together",
            "icon": "mdi-format-columns",
            "doc": "The children are independent and may run at once, as parallel tool calls or sub-agents; succeeds when all have succeeded."
          }
        ]
      },
      {
        "id": "decorators",
        "label": "Wrappers",
        "tools": [
          {
            "id": "retry",
            "kind": "operation",
            "operation": "addRetry",
            "label": "Retry up to N times",
            "icon": "mdi-replay",
            "doc": "Runs the child again when it fails, at most the given number of attempts in total."
          },
          {
            "id": "repeatUntil",
            "kind": "operation",
            "operation": "addRepeatUntil",
            "label": "Repeat until",
            "icon": "mdi-repeat",
            "doc": "Runs the child again and again until the condition in the label holds: the agentic loop, such as working until the tests pass."
          },
          {
            "id": "guard",
            "kind": "operation",
            "operation": "addGuard",
            "label": "Only while",
            "icon": "mdi-shield-outline",
            "doc": "Runs the child only while the condition in the label holds, and abandons it when it stops holding."
          },
          {
            "id": "approval",
            "kind": "operation",
            "operation": "addApproval",
            "label": "Ask approval before",
            "icon": "mdi-account-check-outline",
            "doc": "Describes what the child will do and waits for the user's explicit approval; when refused, the node fails."
          }
        ]
      },
      {
        "id": "leaves",
        "label": "Leaves",
        "tools": [
          {
            "id": "check",
            "kind": "operation",
            "operation": "addCheck",
            "label": "Check",
            "icon": "mdi-help-circle-outline",
            "doc": "A question answered from the conversation, memory or a tool result; succeeds when true, fails when false. Never acts."
          },
          {
            "id": "do",
            "kind": "operation",
            "operation": "addDo",
            "label": "Do",
            "icon": "mdi-play-outline",
            "doc": "One piece of work: a tool call, a written answer, an edit. Succeeds when done."
          },
          {
            "id": "askUser",
            "kind": "operation",
            "operation": "addAskUser",
            "label": "Ask the user",
            "icon": "mdi-account-question-outline",
            "doc": "Asks the question and waits for the answer; succeeds when answered."
          },
          {
            "id": "delegate",
            "kind": "operation",
            "operation": "addDelegate",
            "label": "Delegate",
            "icon": "mdi-account-arrow-right-outline",
            "doc": "Hands the task to a sub-agent or to another behavior file, linked in the label; succeeds when it reports success."
          }
        ]
      }
    ],
    "contextTools": [
      {
        "for": [
          "BehaviorNode"
        ],
        "placement": "menu",
        "tools": [
          {
            "kind": "editLabel",
            "label": "Rename…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "moveEarlier",
            "label": "Move earlier",
            "icon": "mdi-arrow-up",
            "shortcut": "Alt+ArrowUp"
          },
          {
            "kind": "operation",
            "operation": "moveLater",
            "label": "Move later",
            "icon": "mdi-arrow-down",
            "shortcut": "Alt+ArrowDown"
          },
          {
            "kind": "operation",
            "operation": "editNotes",
            "label": {
              "cel": "self.notes != '' ? 'Edit notes…' : 'Add notes…'"
            },
            "icon": "mdi-note-text-outline"
          },
          {
            "kind": "delete",
            "label": "Remove",
            "icon": "mdi-delete-outline",
            "shortcut": "Delete"
          }
        ]
      }
    ]
  },
  "behavior": {
    "doc": "Every change - add, remove, rename, change the kind, edit notes, reorder, re-parent, drag - is one undoable step.",
    "operations": {
      "addSequence": {
        "label": "Do in order",
        "for": "diagram",
        "icon": "mdi-format-list-numbered",
        "doc": "Adds a Do in order where it was dropped, then edits its label in place. Which parent the drop lands under is the runtime's (see agent-behavior-modelling.md); this body is the fallback.",
        "actions": [
          {
            "create": {
              "type": "'Sequence'",
              "parent": "has(self.id) && self.type in ['Sequence', 'Fallback', 'Parallel'] ? self : null",
              "attributes": {
                "label": "'Do in order'"
              }
            },
            "as": "added"
          },
          {
            "select": "added"
          },
          {
            "editLabel": {
              "target": "added",
              "label": "label"
            }
          }
        ]
      },
