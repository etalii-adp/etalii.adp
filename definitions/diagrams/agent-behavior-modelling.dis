        "for": "diagram",
        "icon": "mdi-account-arrow-right-outline",
        "doc": "Adds a Delegate where it was dropped, then edits its label in place. Which parent the drop lands under is the runtime's (see agent-behavior-modelling.md); this body is the fallback.",
        "actions": [
          {
            "create": {
              "type": "'Delegate'",
              "parent": "has(self.id) && self.type in ['Sequence', 'Fallback', 'Parallel'] ? self : null",
              "attributes": {
