          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "'Retry up to ' + string(self.attempts) + ' times'"
            },
            "editable": false,
