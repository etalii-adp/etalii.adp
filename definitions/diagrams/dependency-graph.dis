{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.generic.dependencies",
    "version": "1.0.0",
    "label": "Dependency graph",
    "doc": {
      "summary": "What needs what - named nodes on rows, joined by directed depends-on edges, placed wherever the author puts them.",
      "description": "A node is a labelled box at an **authored position**: a horizontal coordinate the author owns and a row it snaps to. A dependency is a directed edge: its source **depends on** its target, and the arrowhead is drawn at the target, the thing being depended upon.\n\nNeither axis means anything beyond where the author put a node. Rows are a placement grid, not lanes: several nodes may share a row, rows may be negative, and gaps between rows are the author's business.\n\nEverything this specification cannot say (the `.dgr` file format, the gestures, the curve, the validation messages) is written down beside it in `dependency-graph.md`.",
      "tags": ["dependencies", "graph", "boxes and arrows", "architecture", "build order"],
      "seeAlso": [
        { "title": "What DISL cannot express about this diagram type", "href": "https://github.com/etalii-adp/etalii.adp/blob/develop/definitions/diagrams/dependency-graph.md" },
        { "title": "The standalone implementation", "href": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/dependency-graph" }
      ]
    },
    "authors": [ { "name": "Peter Vrenken" } ],
    "license": "Apache-2.0",
    "homepage": "https://etalii.net/adp",
    "icon": "mdi:graph-outline",
    "fileExtension": "dgr",
    "requires": { "conformance": "standard", "features": ["placement.bound", "edge.bezier", "label.parse", "persist.yaml"] }
  },

  "metamodel": {
    "doc": "One node type and one relation type. The diagram root carries no attributes of its own: a new graph is the version marker and an empty element list, and nothing else.",
    "types": {
      "Node": {
        "label": "Node",
        "icon": "mdi:rectangle-outline",
        "doc": {
          "summary": "Something other things can depend on.",
          "description": "A labelled box at an authored position. It has no date, no duration and no instant: the horizontal coordinate means nothing but where the box sits."
        },
        "labelAttribute": "label",
        "attributes": {
          "label": {
            "type": "string",
            "label": "Label",
            "group": "Identity",
            "order": 1,
            "doc": "What the node is called. When it is empty the node shows its id instead."
          },
          "x": {
            "type": "number",
            "label": "X",
            "default": 0,
            "unit": "canvas units",
            "group": "Placement",
            "order": 2,
            "doc": {
              "summary": "The horizontal coordinate of the node's left edge, in canvas units.",
              "description": "Authored, never derived. Whole, fractional, negative and zero values are all valid, and the number is written exactly as the author gave it."
            }
          },
          "row": {
            "type": "int",
            "label": "Row",
            "default": 0,
            "group": "Placement",
            "order": 3,
            "doc": {
              "summary": "Which row the node sits on: a placement grid, not a lane.",
              "description": "Negative rows are as valid as positive ones, several nodes may share a row, and gaps between rows are the author's business. A fractional row is refused rather than truncated."
            }
          }
        }
      }
    },
    "relations": {
      "DependsOn": {
        "label": "Dependency",
        "icon": "mdi:ray-start-arrow",
        "doc": {
          "summary": "The source depends on the target: the one that needs the other points at the one that is needed.",
          "description": "The direction is part of the document, not a drawing convention. Two dependencies between the same pair are legal (the label carries the difference), a dependency need not carry a label, and cycles are allowed: the type has no cycle rule yet."
        },
        "source": { "types": ["Node"], "role": "dependent", "doc": "The node that needs the other." },
        "target": { "types": ["Node"], "role": "dependency", "doc": "The node that is needed." },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "attributes": {
          "label": {
            "type": "string",
            "label": "Label",
            "default": "",
            "group": "Identity",
            "order": 1,
            "doc": "What the author calls the dependency (\"calls\", \"publishes to\"), or empty."
          }
        }
      }
    }
  },

  "coordinates": {
    "doc": "Both axes are authored and neither is derived. Nothing here is a time: this type is the timeline diagram with time taken out.",
    "axes": {
      "x": {
        "kind": "linear",
        "unit": "px",
        "label": "X",
        "doc": "A plain canvas coordinate the author owns. It has no ruler, because there is nothing to name along it."
      },
      "rows": {
        "kind": "linear",
        "unit": "row",
        "scale": 60,
        "precision": 0,
        "label": "Row",
        "doc": "Rows 60 canvas units apart. The spacing is a rendering constant, not data: changing it re-spaces every graph without touching a file."
      }
    },
    "systems": {
      "canvas": {
        "kind": "cartesian",
        "x": "x",
        "y": "rows",
        "orientation": "y-down",
        "infinite": true,
        "grid": { "visible": false },
        "snapping": {
          "mode": "always",
          "userToggle": false,
          "bypassModifier": "none",
          "x": "none",
          "y": { "grid": { "spacing": 1 }, "direction": "nearest" },
          "doc": {
            "summary": "Nodes move freely left and right, and land on the nearest row when dropped.",
            "rationale": "Rows keep related nodes lined up without giving the vertical axis a meaning."
          }
        }
      }
    },
    "default": "canvas"
  },

  "notation": {
    "doc": "The look is the host's shared canvas theme; this type adds only the arrowhead and the loop a dependency draws when it points backwards.",
    "theme": {
      "tokens": {
        "color.surface": "#FFFFFF",
        "color.border": "#8892A6",
        "color.text": "#1C2333",
        "color.text.muted": "#5A6376"
      },
      "followSystem": true
    },
    "styles": {
      "node": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1.5 },
        "cornerRadius": 6,
        "font": { "size": 12, "color": { "token": "color.text" } },
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "dependency": {
        "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 }
      }
    },
    "nodes": {
      "Node": {
        "shape": { "type": "roundedRect", "params": { "radius": 6 } },
        "style": "node",
        "size": { "fixed": [160, 36] },
        "placement": {
          "system": "canvas",
          "x": { "attribute": "x" },
          "y": { "attribute": "row" },
          "anchor": "top-left",
          "movable": true,
          "resizable": false,
          "doc": "Drag anywhere along a row; the node lands on the nearest row when released."
        },
        "labels": [
          {
            "id": "label",
            "text": { "cel": "self.label != '' ? self.label : self.id" },
            "parse": { "write": [ { "set": { "label": "value" } } ] },
            "editable": "inline",
            "position": "center",
            "wrap": "none",
            "maxLines": 1,
            "overflow": "ellipsis",
            "doc": "The node's label, or its id when it has none. Editing it renames the node."
          }
        ],
        "anchors": {
          "mode": "fixed",
          "points": [
            { "id": "left", "x": 0, "y": 0.5 },
            { "id": "right", "x": 1, "y": 0.5 }
          ]
        },
        "copyable": false,
        "doubleClick": "editLabel",
        "accessibility": { "name": { "cel": "'Node ' + (self.label != '' ? self.label : self.id)" } }
      }
    },
    "edges": {
      "DependsOn": {
        "style": "dependency",
        "line": {
          "routing": { "plugin": "adp.dependencyCurve" },
          "startDirection": "right",
          "endDirection": "auto"
        },
        "anchoring": {
          "source": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 }, { "id": "right", "x": 1, "y": 0.5 } ] },
          "target": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 }, { "id": "right", "x": 1, "y": 0.5 } ] }
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          { "id": "label", "text": { "attribute": "label" }, "at": "middle", "side": "above", "distance": 6, "editable": "inline" }
        ],
        "reconnectable": false,
        "accessibility": { "description": { "cel": "self.source.label() + ' depends on ' + self.target.label()" } },
        "doc": "A curve from the dependent to its dependency, with the arrowhead at the dependency."
      }
    }
  },

  "toolbox": {
    "doc": "The palette offers one entry, a node. Dependencies are drawn from a node's side anchors rather than picked from the palette.",
    "groups": [
      {
        "id": "graph",
        "label": "Dependency graph",
        "tools": [
          {
            "id": "node",
            "creates": "Node",
            "label": "Node",
            "icon": "mdi:rectangle-outline",
            "mode": "click",
            "after": "none",
            "initial": { "label": "New node" },
            "doc": "Something other things can depend on. Drop it on the canvas where it belongs."
          }
        ]
      }
    ],
    "tools": {
      "dependsOn": {
        "id": "dependsOn",
        "creates": "DependsOn",
        "label": "Depends on",
        "icon": "mdi:ray-start-arrow",
        "mode": "drag",
        "createSource": "Node",
        "createTarget": "Node",
        "doc": {
          "summary": "Drag from a node's side anchor to another node to make a dependency; release on empty canvas to create the other node there.",
          "description": "Dragged out of the right anchor, the dragged node depends on the one it lands on. Dragged out of the left anchor, the direction reverses: the node it lands on depends on the dragged one. Released on empty canvas, a new node labelled \"New node\" is created at the release point and related, as one undo step."
        }
      }
    },
    "contextMenus": [
      {
        "for": ["Node"],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          { "kind": "editLabel", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
          { "kind": "delete", "label": "Remove", "icon": "mdi:delete-outline", "shortcut": "Delete" },
          { "kind": "operation", "operation": "addRight", "label": "Add node to the right", "icon": "mdi:arrow-expand-right", "shortcut": "Tab" },
          { "kind": "operation", "operation": "addBelow", "label": "Add node below", "icon": "mdi:arrow-expand-down", "shortcut": "Enter" }
        ]
      },
      {
        "for": ["DependsOn"],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          { "kind": "editLabel", "label": "Relabel…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
          { "kind": "delete", "label": "Remove dependency", "icon": "mdi:vector-polyline-remove", "shortcut": "Delete" }
        ]
      }
    ]
  },

  "forms": {
    "node": {
      "for": "Node",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [ { "attribute": "label" } ] },
        { "kind": "section", "title": "Placement", "items": [
          { "attribute": "x", "widget": "number" },
          { "attribute": "row", "widget": "number" }
        ] }
      ]
    },
    "dependency": {
      "for": "DependsOn",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "label" },
          { "kind": "computed", "label": "Depends on (from)", "value": { "cel": "self.source.id" },
            "doc": "Reconnecting is done on the canvas, by dragging the dependency's end to another node." },
          { "kind": "computed", "label": "Depended on (to)", "value": { "cel": "self.target.id" },
            "doc": "Reconnecting is done on the canvas, by dragging the dependency's end to another node." }
        ] }
      ]
    }
  },

  "constraints": {
    "doc": "Every problem is a warning naming its element, because the rest of the graph still draws. The one error, a file that is not YAML, is a loading failure rather than a rule.",
    "builtIn": {
      "std.references": { "severity": "warning" },
      "std.endpoints": { "severity": "warning" }
    }
  },

  "behavior": {
    "doc": "Every edit is one command on the project's history, so each is one undo away.",
    "operations": {
      "addRight": {
        "label": "Add node to the right",
        "icon": "mdi:arrow-expand-right",
        "shortcut": "Tab",
        "for": ["Node"],
        "doc": "Adds a node a fixed step to the right on the same row, which the selected node depends on.",
        "actions": [
          { "create": { "type": "'Node'", "attributes": { "label": "'New node'", "x": "self.x + 240.0", "row": "self.row" } }, "as": "added" },
          { "connect": { "type": "'DependsOn'", "source": "self", "target": "added" } }
        ]
      },
      "addBelow": {
        "label": "Add node below",
        "icon": "mdi:arrow-expand-down",
        "shortcut": "Enter",
        "for": ["Node"],
        "doc": "Adds a node at the same coordinate one row down, which the selected node depends on.",
        "actions": [
          { "create": { "type": "'Node'", "attributes": { "label": "'New node'", "x": "self.x", "row": "self.row + 1" } }, "as": "added" },
          { "connect": { "type": "'DependsOn'", "source": "self", "target": "added" } }
        ]
      }
    },
    "deletion": {
      "Node": { "relations": "delete" }
    }
  },

  "layout": {
    "doc": "No automatic layout: every position is the author's.",
    "algorithms": { "manual": { "algorithm": "none" } },
    "default": "manual",
    "trigger": "manual"
  },

  "persistence": {
    "doc": "Stored as a `.dgr` file: ADP's own YAML schema, owned outright by this type. The file is not a DID definition; the format plugin maps it to and from one (see dependency-graph.md).",
    "format": "plugin:adp.dgr",
    "encoding": "utf-8",
    "newline": "crlf",
    "finalNewline": true,
    "files": { "mode": "single", "model": "{name}.dgr" },
    "ids": {
      "strategy": "uuid-v4",
      "stable": true,
      "doc": "New ids are ShortGuids: a random UUID written as 22 URL-safe base64 characters. Hand-written ids such as `api-gateway` are kept as they are."
    },
    "ordering": { "elements": "creation", "keys": "canonical" },
    "omitDefaults": false,
    "view": { "store": [] },
    "collaboration": { "mode": "none" }
  },

  "plugins": {
    "adp.dgr": {
      "version": "^1.0.0",
      "provides": ["persistenceFormat"],
      "required": true,
      "doc": "Reads and writes the `.dgr` YAML document: the version marker `dependencies: 1`, an `elements` list and a `relations` list. Writes are line splices, so an unchanged file round-trips byte-identically and an edit changes only the lines it affects."
    },
    "adp.dependencyCurve": {
      "version": "^1.0.0",
      "provides": ["routing"],
      "required": false,
      "fallback": { "routing": "bezier" },
      "doc": "The dependency curve: a horizontal bezier between the facing side anchors while the dependency sits clear to the right, and a forward loop out of the dependent's right side into the dependency's left side when it sits behind."
    }
  },

  "x-adp": {
    "origin": "generic/dependencies",
    "kind": "Diagram",
    "state": "Implemented",
    "implementations": {
      "standalone": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/dependency-graph"
    }
  }
}
