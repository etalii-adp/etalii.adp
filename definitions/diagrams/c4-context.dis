      }
    },
    "edges": {
      "Relationship": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.line"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "label",
            "at": "middle",
            "side": "above",
            "distance": 6,
            "orientation": "horizontal",
            "text": {
              "cel": "self.description + (self.technology != '' ? ' [' + self.technology + ']' : '')"
            },
            "editable": "inline",
            "parse": {
              "cel": "value",
              "write": [
                {
                  "set": {
                    "description": "value"
                  }
                }
              ]
            },
            "style": "relationshipLabel",
            "wrap": "none"
          }
        ],
        "anchoring": {
          "source": {
            "mode": "outline"
          },
          "target": {
            "mode": "outline"
          }
        },
        "deletable": false,
        "reconnectable": false,
        "doc": "A dashed, unidirectional arrow labelled with what the relationship is for and, in brackets, its technology."
      }
    },
    "canvas": {
      "background": {
        "token": "color.canvas"
      },
      "legend": {
        "visible": true,
        "position": "bottom"
      },
      "doc": "The diagram's heading is drawn above the canvas and a key of the element kinds below it, because C4 asks every diagram to have a title and a key."
    },
    "doc": "The Structurizr default theme, which is what the c4model.com reference diagrams show. C4 itself is notation independent, so these colours are ADP's default and not a rule: no constraint is expressed in terms of colour."
  },
  "toolbox": {
    "groups": [
      {
        "id": "elements",
        "label": "C4 system context diagram",
        "tools": [
          {
            "id": "person",
            "creates": "Person",
            "label": "Person",
            "icon": "mdi:account-outline",
            "mode": "click",
            "after": "editLabel",
            "doc": "Someone who uses the software."
          },
          {
            "id": "softwareSystem",
            "creates": "SoftwareSystem",
            "label": "Software System",
            "icon": "mdi:application-outline",
            "mode": "click",
            "after": "editLabel",
            "doc": "Another system this one talks to."
          }
        ],
        "doc": "Exactly the element kinds a System Context view permits, so the toolbox never offers something the view would refuse."
      }
    ],
    "generic": {
      "select": true,
      "pan": true,
      "lasso": false,
      "text": false,
      "note": false,
      "image": false,
      "freehand": false
    },
    "searchable": false,
    "contextTools": [
      {
        "for": [
          "NamedElement"
        ],
        "placement": "menu",
        "tools": [
          {
            "kind": "editLabel",
            "label": "Rename…",
            "icon": "mdi:pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "editDescription",
            "icon": "mdi:text-box-outline"
          }
        ]
      },
      {
        "for": [
          "Container",
          "Component",
          "DeploymentNode",
          "InfrastructureNode"
        ],
        "placement": "menu",
        "tools": [
          {
            "kind": "operation",
            "operation": "setTechnology",
            "icon": "mdi:tools"
          }
        ]
      },
      {
        "for": [
          "Relationship"
        ],
        "placement": "menu",
        "tools": [
          {
            "kind": "editLabel",
            "label": "Relabel…",
            "icon": "mdi:pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "setProtocol",
            "icon": "mdi:transit-connection-variant"
          }
        ]
      }
    ],
    "doc": "Dropping an element on the canvas adds it to the model in the DSL document. People and software systems always go to the top of the model; a container goes inside the software system it is dropped on, a component inside the container."
  },
  "forms": {
    "elementInspector": {
      "for": [
        "NamedElement"
      ],
      "usage": [
        "inspector"
      ],
      "commit": "onBlur",
      "items": [
        {
          "attribute": "name",
          "widget": "text"
        },
        {
          "attribute": "description",
          "widget": "textarea",
          "rows": 3
        },
        {
          "attribute": "technology",
          "widget": "text",
          "visible": "self.isA('Container') || self.isA('Component') || self.isA('DeploymentNode') || self.isA('InfrastructureNode')"
        },
        {
          "attribute": "tags",
          "widget": "tags",
          "readOnly": true,
          "doc": "Tags are edited in the document until an action exists for them."
        },
        {
          "kind": "section",
          "title": "Model",
          "items": [
            {
              "kind": "computed",
              "label": "Kind",
              "value": {
                "cel": "self.type"
              },
              "doc": "Changing this changes the shape of the model rather than a value, so it is done from the diagram rather than here."
            },
            {
              "kind": "computed",
              "label": "Identifier",
              "value": {
                "cel": "self.id"
              },
              "doc": "Changing this changes the shape of the model rather than a value, so it is done from the diagram rather than here."
            }
          ]
        }
      ],
      "doc": "The property grid of an element."
    },
    "relationshipInspector": {
      "for": [
        "Relationship"
      ],
      "usage": [
        "inspector"
      ],
      "commit": "onBlur",
      "items": [
        {
          "attribute": "description",
          "widget": "text"
        },
        {
          "attribute": "technology",
          "widget": "text"
        },
        {
          "kind": "computed",
          "label": "From",
          "value": {
            "cel": "self.source.label()"
          },
          "doc": "The ends of a relationship are what it is. Draw a different relationship to connect something else."
        },
        {
          "kind": "computed",
          "label": "To",
          "value": {
            "cel": "self.target.label()"
          },
          "doc": "The ends of a relationship are what it is. Draw a different relationship to connect something else."
        }
      ],
      "doc": "The property grid of a relationship."
    }
  },
  "constraints": {
    "groups": {
      "c4": {
        "label": "C4 rules",
        "doc": "The rules of the C4 model, reported as warnings: a model mid-edit is routinely incomplete, and saving is never blocked."
      }
    },
    "defaults": {
      "severity": "warning",
      "timing": [
        "live",
        "save"
      ]
    },
    "blockSaveOn": "never",
    "builtIn": {
      "std.required": {
        "severity": "warning"
      },
      "std.containment": {
        "severity": "warning"
      },
      "std.references": {
        "severity": "warning"
      }
    },
    "rules": [
      {
        "id": "missingDescription",
        "label": "Missing description",
        "scope": [
          "Person",
          "SoftwareSystem",
          "Container",
          "Component"
        ],
        "rule": "self.description.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        },
        "tags": [
          "c4.missing-description",
          "structurizr:model.person.description",
          "structurizr:model.softwaresystem.description",
          "structurizr:model.container.description",
          "structurizr:model.component.description"
        ],
        "attribute": "description"
      },
      {
        "id": "missingDeploymentDescription",
        "label": "Missing description",
        "scope": [
          "DeploymentNode"
        ],
        "rule": "self.description.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        },
        "tags": [
          "c4.missing-deployment-description",
          "structurizr:model.deploymentnode.description"
        ],
        "attribute": "description"
      },
      {
        "id": "missingInfrastructureDescription",
        "label": "Missing description",
        "scope": [
          "InfrastructureNode"
        ],
        "rule": "self.description.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        },
        "tags": [
          "c4.missing-infrastructure-description",
          "structurizr:model.infrastructurenode.description"
        ],
        "attribute": "description"
      },
      {
        "id": "missingTechnology",
        "label": "Missing technology",
        "scope": [
          "Container",
          "Component"
        ],
        "rule": "self.technology.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' has no technology. C4 asks for one explicitly on every \" + (self.isA('Container') ? 'container' : 'component') + \".\""
        },
        "tags": [
          "c4.missing-technology",
          "structurizr:model.container.technology"
        ],
        "attribute": "technology"
      },
      {
        "id": "missingDeploymentTechnology",
        "label": "Missing technology",
        "scope": [
          "DeploymentNode"
        ],
        "rule": "self.technology.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' names no technology. A deployment diagram is read to find out what actually runs where, so say what this node is.\""
        },
        "tags": [
          "c4.missing-deployment-technology",
          "structurizr:model.deploymentnode.technology"
        ],
        "attribute": "technology"
      },
      {
        "id": "missingInfrastructureTechnology",
        "label": "Missing technology",
        "scope": [
          "InfrastructureNode"
        ],
        "rule": "self.technology.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' names no technology. A deployment diagram is read to find out what actually runs where, so say what this node is.\""
        },
        "tags": [
          "c4.missing-infrastructure-technology",
          "structurizr:model.infrastructurenode.technology"
        ],
        "attribute": "technology"
      },
      {
        "id": "disconnectedElement",
        "label": "Disconnected element",
        "scope": [
          "Person",
          "SoftwareSystem",
          "Container",
          "Component"
        ],
        "rule": "diagram.relationsOfType('Relationship').exists(r, (r.source.id == self.id || r.source.ancestors().exists(a, a.id == self.id)) != (r.target.id == self.id || r.target.ancestors().exists(a, a.id == self.id)))",
        "severity": "warning",
        "message": {
          "cel": "\"'\" + (self.name != '' ? self.name : self.id) + \"' is in no relationship at all. An element nothing reaches and that reaches nothing is either unfinished or left over.\""
        },
        "tags": [
          "c4.disconnected-element",
          "structurizr:model.element.disconnected"
        ],
        "doc": {
          "summary": "Every person, system, container and component takes part in at least one relationship.",
          "description": "A relationship connects every element on the ancestor chain of one end that is not also on the ancestor chain of the other, so a relationship between two containers also connects their systems when they differ."
        }
      },
      {
        "id": "misplacedContainer",
        "label": "Misplaced container",
        "scope": [
          "Container"
        ],
        "rule": "self.parent != null && self.parent.isA('SoftwareSystem')",
        "severity": "warning",
        "message": {
          "cel": "self.parent == null ? \"'\" + (self.name != '' ? self.name : self.id) + \"' is a container declared outside any software system. In C4 a container is part of a software system.\" : \"'\" + (self.name != '' ? self.name : self.id) + \"' is a container inside a \" + self.parent.type + \". In C4 a container is part of a software system.\""
        },
        "tags": [
          "c4.misplaced-element"
        ]
      },
      {
        "id": "misplacedComponent",
        "label": "Misplaced component",
        "scope": [
          "Component"
        ],
        "rule": "self.parent != null && self.parent.isA('Container')",
        "severity": "warning",
        "message": {
          "cel": "self.parent == null ? \"'\" + (self.name != '' ? self.name : self.id) + \"' is a component declared outside any container. In C4 a component is part of a container.\" : \"'\" + (self.name != '' ? self.name : self.id) + \"' is a component inside a \" + self.parent.type + \". In C4 a component is part of a container.\""
        },
        "tags": [
          "c4.misplaced-element"
        ]
      },
      {
        "id": "unlabelledRelationship",
        "label": "Unlabelled relationship",
        "scope": "Relationship",
        "rule": "self.description.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"The relationship from '\" + (self.source.name != '' ? self.source.name : self.source.id) + \"' to '\" + (self.target.name != '' ? self.target.name : self.target.id) + \"' has no label. C4 asks what the relationship is for, in the direction of the arrow.\""
        },
        "tags": [
          "c4.unlabelled-relationship"
        ],
        "attribute": "description"
      },
      {
        "id": "missingProtocol",
        "label": "Missing technology",
        "scope": "Relationship",
        "rule": "self.technology.trim() != ''",
        "severity": "warning",
        "message": {
          "cel": "\"The relationship from '\" + (self.source.name != '' ? self.source.name : self.source.id) + \"' to '\" + (self.target.name != '' ? self.target.name : self.target.id) + \"' names no technology. How two elements communicate - a protocol, a library, a call - is what tells a reader where a boundary really is.\""
        },
        "tags": [
          "c4.missing-protocol",
          "structurizr:model.relationship.technology"
        ],
        "attribute": "technology"
      },
      {
        "id": "kindNotPermittedOnView",
        "label": "Kind not permitted on this view",
        "scope": "diagram",
        "rule": "!diagram.nodes.exists(n, n.id in diagram.includes && !(n.isA('Person') || n.isA('SoftwareSystem')))",
        "severity": "warning",
        "message": {
          "cel": "\"The '\" + diagram.viewKey + \"' view includes an element this kind of view does not show. A System Context view shows people and software systems.\""
        },
        "tags": [
          "c4.kind-not-permitted-on-view"
        ],
        "target": "diagram.nodes.filter(n, n.id in diagram.includes && !(n.isA('Person') || n.isA('SoftwareSystem')))"
      },
      {
        "id": "emptyView",
        "label": "Empty view",
        "scope": "diagram",
        "rule": "diagram.nodes.exists(n, (('*' in diagram.includes) || n.id in diagram.includes) && !(n.id in diagram.excludes) && (n.isA('Person') || n.isA('SoftwareSystem')))",
        "severity": "warning",
        "message": {
          "cel": "\"The '\" + diagram.viewKey + \"' view is empty.\""
        },
        "tags": [
          "c4.empty-view"
        ]
      },
      {
        "id": "unknownViewScope",
        "label": "Unknown view scope",
        "scope": "diagram",
        "rule": "!has(diagram.scope) || diagram.scope != null",
        "severity": "warning",
        "message": {
          "cel": "\"The '\" + diagram.viewKey + \"' view is scoped to an element the model does not declare.\""
        },
        "tags": [
          "c4.unknown-view-scope"
        ]
      },
      {
        "id": "containerNeedsSystem",
        "kind": "create",
        "label": "A container lives inside a software system",
        "when": "elementType == 'Container'",
        "rule": "parent != null && parent.isA('SoftwareSystem')",
        "message": {
          "cel": "parent == null ? 'A container lives inside a software system. Drop it on one.' : 'A container lives inside a software system, not inside a ' + parent.type + '.'"
        },
        "enforcement": "prevent",
        "severity": "error",
        "tags": [
          "c4.placement"
        ]
      },
      {
        "id": "componentNeedsContainer",
        "kind": "create",
        "label": "A component lives inside a container",
        "when": "elementType == 'Component'",
        "rule": "parent != null && parent.isA('Container')",
        "message": {
          "cel": "parent == null ? 'A component lives inside a container. Drop it on one.' : 'A component lives inside a container, not inside a ' + parent.type + '.'"
        },
        "enforcement": "prevent",
        "severity": "error",
        "tags": [
          "c4.placement"
        ]
      },
      {
        "id": "nameRequired",
        "kind": "change",
        "label": "Every C4 element needs a name",
        "when": "attribute == 'name'",
        "rule": "string(newValue).trim() != ''",
        "message": "Every C4 element needs a name.",
        "enforcement": "prevent",
        "severity": "error"
      },
      {
        "id": "dragDoesNotReparent",
        "kind": "placement",
        "label": "Dragging does not change containment",
        "rule": "newParent == self.parent",
        "message": "Dragging changes where an element is drawn, not what contains it.",
        "enforcement": "prevent",
        "severity": "error"
      }
    ]
  },
  "behavior": {
    "hooks": [
      {
        "id": "placeholderDescription",
        "on": "create",
        "for": "NamedElement",
        "when": "!has(self.description)",
        "actions": [
          {
            "set": {
              "description": "'Describe ' + self.name + '.'"
            }
          }
        ],
        "doc": "A new element is written with a placeholder description, so it does not greet its author with a warning they did not cause."
      },
      {
        "id": "topLevelOnly",
        "on": "create",
        "for": [
          "Person",
          "SoftwareSystem"
        ],
        "when": "self.parent != null",
        "actions": [
          {
            "reparent": {
              "target": "self",
              "parent": "null"
            }
          }
        ],
        "doc": "People and software systems always go to the top of the model, even when dropped on another element."
      }
    ],
    "operations": {
      "editDescription": {
        "label": "Edit description…",
        "for": [
          "NamedElement"
        ],
        "params": {
          "description": {
            "type": "text",
            "label": "Description"
          }
        },
        "actions": [
          {
            "set": {
              "description": "p.description"
            }
          }
        ],
        "doc": "Opens a prompt titled \"Describe element\"; offered as \"Add description…\" when the element has none."
      },
      "setTechnology": {
        "label": "Set technology…",
        "for": [
          "Container",
          "Component",
          "DeploymentNode",
          "InfrastructureNode"
        ],
        "params": {
          "technology": {
            "type": "string",
            "label": "Technology"
          }
        },
        "actions": [
          {
            "set": {
              "technology": "p.technology"
            }
          }
        ],
        "doc": "Offered as \"Change technology…\" when the element already names one."
      },
      "setProtocol": {
        "label": "Set technology…",
        "for": [
          "Relationship"
        ],
        "params": {
          "technology": {
            "type": "string",
            "label": "Technology"
          }
        },
        "actions": [
          {
            "set": {
              "technology": "p.technology"
            }
          }
        ]
      }
    },
    "clipboard": {
      "relations": "none",
      "crossDocument": false,
      "formats": []
    },
    "doc": "Every edit is one undoable command. Elements and relationships cannot yet be deleted, connected or reversed from the diagram; they are removed or drawn in the DSL."
  },
  "layout": {
    "algorithms": {
      "c4Ranks": {
        "algorithm": "layered",
        "direction": "down",
        "spacing": {
          "layer": 120,
          "node": 60
        },
        "edgeRouting": "straight",
        "scope": "all",
        "doc": "Longest-path ranks along the view's relationships, one row per rank centred on the axis, in the direction the view's `autoLayout` names (top to bottom when it names none), with the view's own rank and node separation when it declares them. DISL has no way to bind an algorithm's direction or spacing to a diagram attribute, so the values here are the defaults; see the companion .md."
      }
    },
    "default": "c4Ranks",
    "trigger": "always",
    "respect": "pinned",
    "animate": false,
    "doc": "Every view is laid out by ADP. A position dragged on the canvas is kept for that view and replaces the computed one, except in a view that declares `autoLayout`, where the DSL wins."
  },
  "persistence": {
    "format": "plugin:structurizrDsl",
    "encoding": "utf-8",
    "files": {
      "mode": "split",
      "model": "{name}.dsl",
      "view": "{name}.layout.json"
    },
    "ids": {
      "strategy": "natural",
      "stable": true,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "doc": "Structurizr DSL identifiers: the identifier of `id = keyword ...`, or one ADP derives from the name for a new element."
    },
    "view": {
      "store": [
        "bounds"
      ],
      "styleOverrides": "none"
    },
    "omitDefaults": true,
    "precision": {
      "canvas": 2
    },
    "doc": "The model is a Structurizr DSL document ADP edits in place, line by line, so an unedited document is byte-identical after a save. Positions dragged on the canvas go in a JSON sidecar beside it, keyed by view and element."
  },
  "viewpoints": {
    "systemContext": {
      "label": "System Context view",
      "include": [
        "Person",
        "SoftwareSystem"
      ],
      "exclude": [
        "Container",
        "Component",
        "DeploymentNode",
        "InfrastructureNode",
        "ContainerInstance",
        "SoftwareSystemInstance"
      ],
      "layout": "c4Ranks",
      "default": true,
      "doc": "A System Context view shows people and software systems. The model behind it holds every other kind too, for the other C4 diagram types to show."
    }
  },
  "plugins": {
    "structurizrDsl": {
      "version": "^0.1.0",
      "provides": [
        "persistenceFormat",
        "import"
      ],
      "required": true,
      "doc": {
        "summary": "Reads a Structurizr DSL workspace into the C4 model and writes edits back into the same text.",
        "description": "A forgiving, line-based reader of the DSL subset ADP models, and a writer that replaces only the quoted argument an edit changes.",
        "seeAlso": [
          {
            "title": "Structurizr DSL language reference",
            "href": "https://docs.structurizr.com/dsl/language"
          }
        ]
      },
      "source": {
        "url": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/c4/backend/EtAlii.Adp.Diagram.C4"
      }
    }
  }
}
