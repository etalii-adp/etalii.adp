{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.c4.context",
    "version": "0.1.0",
    "label": "C4 system context diagram",
    "license": "Apache-2.0",
    "homepage": "https://etalii.net/adp",
    "icon": "mdi:earth",
    "fileExtension": "dsl",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "requires": {
      "conformance": "standard"
    },
    "doc": {
      "summary": "The system in its world: who uses it, and what it depends on. The map to start with.",
      "description": "A C4 system context diagram shows one software system, the people who use it and the other software systems it depends on or that depend on it. Its audience is everybody, technical or not. It is one view of a C4 model kept in a Structurizr DSL document, which the other C4 diagram types view too.\n\nIn the ADP catalogue this diagram type is `c4/context`. Everything this specification cannot express is written down in `c4-context.md` beside it.",
      "helpUrl": "https://c4model.com/diagrams/system-context",
      "seeAlso": [
        {
          "title": "The C4 model",
          "href": "https://c4model.com"
        },
        {
          "title": "Structurizr DSL",
          "href": "https://docs.structurizr.com/dsl"
        }
      ],
      "tags": [
        "c4",
        "architecture",
        "software delivery",
        "systems and strategy"
      ]
    }
  },
  "metamodel": {
    "diagram": {
      "attributes": {
        "viewKey": {
          "type": "string",
          "label": "View key",
          "required": true,
          "readOnly": true,
          "order": 1,
          "default": "systemcontext",
          "doc": {
            "summary": "The key of the Structurizr view this diagram shows.",
            "description": "Named on the `view:` line of the `.adp` registration. Without one, the diagram shows the document's first view."
          }
        },
        "title": {
          "type": "string",
          "order": 2,
          "doc": {
            "summary": "The title the view declares with a `title` line.",
            "description": "When the view declares none, the diagram is titled by `heading`, which follows C4's advice that a title names the diagram type and its scope."
          }
        },
        "heading": {
          "type": "string",
          "order": 3,
          "derived": "self.title != '' ? self.title : 'System Context diagram for ' + (self.scope != null ? self.scope.name : '')",
          "doc": "The title drawn above the diagram: the declared title, or one derived from the diagram type and its scope."
        },
        "includes": {
          "type": "string",
          "many": true,
          "readOnly": true,
          "order": 10,
          "group": "View",
          "doc": {
            "summary": "The view's `include` expressions: element identifiers, or `*` for every element of a kind this diagram type permits.",
            "description": "ADP reads identifiers and `*`. `*` is not narrowed by the view's scope: it includes every element of a permitted kind in the whole model."
          }
        },
        "excludes": {
          "type": "string",
          "many": true,
          "readOnly": true,
          "order": 11,
          "group": "View",
          "doc": "The view's `exclude` identifiers, removed from what `includes` selects."
        },
        "autoLayout": {
          "type": "RankDirection",
          "label": "Automatic layout",
          "readOnly": true,
          "order": 12,
          "group": "View",
          "doc": {
            "summary": "The view's `autoLayout` direction. When it is set, positions dragged on the canvas are not used.",
            "description": "`autoLayout` with no direction means top to bottom. Unset means the view declares no `autoLayout`."
          }
        },
        "rankSeparation": {
          "type": "int",
          "min": 0,
          "unit": "px",
          "default": 120,
          "readOnly": true,
          "order": 13,
          "group": "View",
          "doc": "The distance between ranks, the second argument of `autoLayout`."
        },
        "nodeSeparation": {
          "type": "int",
          "min": 0,
          "unit": "px",
          "default": 60,
          "readOnly": true,
          "order": 14,
          "group": "View",
          "doc": "The distance between elements of one rank, the third argument of `autoLayout`."
        },
        "workspaceName": {
          "type": "string",
          "label": "Workspace",
          "readOnly": true,
          "order": 20,
          "group": "Model",
          "doc": "The name of the Structurizr workspace, the first argument of `workspace`."
        },
        "scope": {
          "type": "SoftwareSystem",
          "readOnly": true,
          "order": 5,
          "required": true,
          "doc": {
            "summary": "The one software system this view is about.",
            "description": "The first argument of the `systemContext` view."
          }
        }
      },
      "doc": "One view of a Structurizr workspace: which view, how it is titled, what it includes and how it is laid out."
    },
    "enums": {
      "RankDirection": {
        "values": {
          "tb": {
            "label": "Top to bottom"
          },
          "bt": {
            "label": "Bottom to top"
          },
          "lr": {
            "label": "Left to right"
          },
          "rl": {
            "label": "Right to left"
          }
        },
        "doc": "The directions `autoLayout` accepts."
      }
    },
    "types": {
      "Element": {
        "abstract": true,
        "attributes": {
          "tags": {
            "type": "string",
            "many": true,
            "order": 4,
            "readOnly": true,
            "group": "Model",
            "doc": {
              "summary": "Structurizr tags, such as External, Database or Queue.",
              "description": "Comma-separated in the declaration's tags argument, or listed on a `tags` line inside the element's block. The tags `External` and `Existing System` mark an element as outside the scope being described; `Database` draws it as a cylinder. Tags are edited in the DSL document; ADP offers no action for them yet."
            }
          },
          "external": {
            "type": "bool",
            "label": "External",
            "derived": "self.tags.exists(t, t.lowerAscii() == 'external' || t.lowerAscii() == 'existing system')",
            "doc": {
              "summary": "Outside the scope being described, and drawn muted grey.",
              "description": "True when the element carries the tag `External` or `Existing System` (case-insensitive). Being external is decided by tags only."
            }
          }
        },
        "doc": "Anything a C4 model declares: a person, a software system, a container, a component or one of the deployment elements."
      },
      "NamedElement": {
        "abstract": true,
        "extends": "Element",
        "attributes": {
          "name": {
            "type": "string",
            "required": true,
            "key": true,
            "order": 1,
            "doc": {
              "summary": "What the element is called, as a reader of the diagram would say it.",
              "description": "The first quoted argument of the element's Structurizr DSL declaration. A name may be an acronym, but then the description has to say what it stands for."
            }
          },
          "description": {
            "type": "text",
            "order": 2,
            "doc": {
              "summary": "One or two sentences on what this element is responsible for.",
              "rationale": "C4 asks for a short description on every element, so a reader can tell at a glance what it does without asking anyone."
            }
          }
        },
        "doc": "An element with its own name and description, which is every element except a deployed instance."
      },
      "Person": {
        "extends": "NamedElement",
        "doc": {
          "summary": "Someone who uses the software: a human user, a role, an actor or a persona.",
          "helpUrl": "https://c4model.com/abstractions/person"
        }
      },
      "SoftwareSystem": {
        "extends": "NamedElement",
        "label": "Software system",
        "children": {
          "allowed": [
            "Container"
          ],
          "acrossViews": true
        },
        "doc": {
          "summary": "Something that delivers value to its users, whether you build it or not.",
          "description": "The highest level of abstraction in C4. Its containers are nested inside its block in the DSL.",
          "helpUrl": "https://c4model.com/abstractions/software-system"
        }
      },
      "Container": {
        "extends": "NamedElement",
        "attributes": {
          "technology": {
            "type": "string",
            "order": 3,
            "doc": {
              "summary": "The technology it is built with or runs on, for example \"Java and Spring MVC\" or \"PostgreSQL 16\".",
              "rationale": "C4 asks for an explicitly specified technology on every container and component; it is what tells a reader how the thing is built."
            }
          }
        },
        "children": {
          "allowed": [
            "Component"
          ],
          "acrossViews": true
        },
        "doc": {
          "summary": "An application or a data store - not a Docker container.",
          "description": "Something that needs to be running for the software system to work: a server-side web application, a single-page application, a mobile app, a database schema, a folder on a file system, a serverless function. A container belongs to exactly one software system.",
          "helpUrl": "https://c4model.com/abstractions/container"
        }
      },
      "Component": {
        "extends": "NamedElement",
        "attributes": {
          "technology": {
            "type": "string",
            "order": 3,
            "doc": {
              "summary": "The technology it is built with or runs on, for example \"Java and Spring MVC\" or \"PostgreSQL 16\".",
              "rationale": "C4 asks for an explicitly specified technology on every container and component; it is what tells a reader how the thing is built."
            }
          }
        },
        "doc": {
          "summary": "A grouping of related functionality inside a container.",
          "description": "A component belongs to exactly one container. It is not a separately deployable unit.",
          "helpUrl": "https://c4model.com/abstractions/component"
        }
      },
      "DeploymentNode": {
        "extends": "NamedElement",
        "label": "Deployment node",
        "attributes": {
          "technology": {
            "type": "string",
            "order": 3,
            "doc": {
              "summary": "The technology it is built with or runs on, for example \"Java and Spring MVC\" or \"PostgreSQL 16\".",
              "rationale": "C4 asks for an explicitly specified technology on every container and component; it is what tells a reader how the thing is built."
            }
          }
        },
        "children": {
          "allowed": [
            "DeploymentNode",
            "InfrastructureNode",
            "ContainerInstance",
            "SoftwareSystemInstance"
          ]
        },
        "doc": {
          "summary": "Where things run: a server, a cluster, an execution environment.",
          "description": "Physical or virtual infrastructure, a containerised environment or an execution context. Deployment nodes nest to any depth.",
          "helpUrl": "https://c4model.com/diagrams/deployment"
        }
      },
      "InfrastructureNode": {
        "extends": "NamedElement",
        "label": "Infrastructure node",
        "attributes": {
          "technology": {
            "type": "string",
            "order": 3,
            "doc": {
              "summary": "The technology it is built with or runs on, for example \"Java and Spring MVC\" or \"PostgreSQL 16\".",
              "rationale": "C4 asks for an explicitly specified technology on every container and component; it is what tells a reader how the thing is built."
            }
          }
        },
        "doc": "Supporting infrastructure: DNS, a load balancer, a firewall."
      },
      "ContainerInstance": {
        "extends": "Element",
        "label": "Container instance",
        "labelAttribute": "container",
        "attributes": {
          "container": {
            "type": "Container",
            "required": true,
            "order": 1,
            "doc": "The container this is a deployed copy of. The instance has no name of its own; it shows the container's."
          }
        },
        "doc": "A container, deployed onto a deployment node. It refers to the container in the model rather than duplicating it, so one container can have several instances."
      },
      "SoftwareSystemInstance": {
        "extends": "Element",
        "label": "Software system instance",
        "labelAttribute": "softwareSystem",
        "attributes": {
          "softwareSystem": {
            "type": "SoftwareSystem",
            "required": true,
            "order": 1,
            "label": "Software system",
            "doc": "The software system this is a deployed copy of."
          }
        },
        "doc": "A software system, deployed onto a deployment node."
      }
    },
    "relations": {
      "Relationship": {
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "attributes": {
          "description": {
            "type": "string",
            "order": 1,
            "doc": {
              "summary": "What the relationship is for, read in the direction of the arrow, for example \"Sends e-mails using\".",
              "rationale": "C4 asks for every relationship to be labelled and unidirectional."
            }
          },
          "technology": {
            "type": "string",
            "order": 2,
            "doc": {
              "summary": "How the two communicate: a protocol, a library, a call, for example \"JSON/HTTPS\".",
              "rationale": "The technology of a relationship is what tells a reader where a boundary really is."
            }
          },
          "tags": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "order": 3,
            "doc": "The relationship's Structurizr tags, as one string (they are not split on commas)."
          }
        },
        "doc": {
          "summary": "A unidirectional dependency or interaction between two elements of the model.",
          "description": "Written `source -> destination \"description\" \"technology\" \"tags\"` in the model, or `-> destination \"description\" \"technology\"` inside the source's block. A view shows a relationship between the nearest ancestors of its ends that the view draws (an implied relationship), once per pair."
        }
      }
    },
    "doc": "The C4 model as the Structurizr DSL declares it: one model shared by every C4 diagram type, of which this diagram type shows one view."
  },
  "notation": {
    "theme": {
      "tokens": {
        "color.person": "#08427b",
        "color.softwareSystem": "#1168bd",
        "color.container": "#438dd5",
        "color.component": "#85bbf0",
        "color.deploymentNode": "#ffffff",
        "color.external": "#999999",
        "color.onDark": "#ffffff",
        "color.onLight": "#000000",
        "color.line": "#8A8880",
        "color.muted": "#6B6A65",
        "color.canvas": "#FFFFFF",
        "font.body": "system-ui, sans-serif"
      },
      "modes": {
        "dark": {
          "color.line": "#B4B2A9",
          "color.muted": "#A9A79E",
          "color.canvas": "#1F1E1C"
        }
      },
      "defaultMode": "light",
      "followSystem": true
    },
    "shapes": {
      "c4Person": {
        "label": "Person",
        "doc": "A rounded box with a round head of radius 10 above its top edge, as the Structurizr default theme draws a person.",
        "parts": [
          {
            "id": "head",
            "shape": "circle",
            "box": {
              "x": "w / 2.0 - 10.0",
              "y": -28,
              "w": 20,
              "h": 20
            }
          },
          {
            "id": "body",
            "shape": {
              "type": "roundedRect",
              "params": {
                "radius": 8
              }
            },
            "box": {
              "x": 0,
              "y": 0,
              "w": "w",
              "h": "h"
            },
            "outline": true
          }
        ]
      },
      "c4Cylinder": {
        "label": "Cylinder",
        "doc": "A data store: a box with an elliptical cap of height 12 at the top and bottom.",
        "parts": [
          {
            "id": "side",
            "shape": "rect",
            "box": {
              "x": 0,
              "y": 6,
              "w": "w",
              "h": "h - 12.0"
            },
            "outline": true
          },
          {
            "id": "bottom",
            "shape": "ellipse",
            "box": {
              "x": 0,
              "y": "h - 12.0",
              "w": "w",
              "h": 12
            }
          },
          {
            "id": "top",
            "shape": "ellipse",
            "box": {
              "x": 0,
              "y": 0,
              "w": "w",
              "h": 12
            }
          }
        ]
      }
    },
    "styles": {
      "card": {
        "stroke": {
          "color": "none",
          "width": 0
        },
        "font": {
          "family": {
            "token": "font.body"
          },
          "size": 14,
          "lineHeight": 1.4
        },
        "padding": [
          10,
          12
        ],
        "textAlign": "center",
        "cursor": "grab"
      },
      "person": {
        "extends": "card",
        "fill": {
          "token": "color.person"
        },
        "font": {
          "color": {
            "token": "color.onDark"
          }
        }
      },
      "softwareSystem": {
        "extends": "card",
        "fill": {
          "token": "color.softwareSystem"
        },
        "font": {
          "color": {
            "token": "color.onDark"
          }
        }
      },
      "container": {
        "extends": "card",
        "fill": {
          "token": "color.container"
        },
        "font": {
          "color": {
            "token": "color.onDark"
          }
        }
      },
      "component": {
        "extends": "card",
        "fill": {
          "token": "color.component"
        },
        "font": {
          "color": {
            "token": "color.onLight"
          }
        }
      },
      "deploymentNode": {
        "extends": "card",
        "fill": {
          "token": "color.deploymentNode"
        },
        "font": {
          "color": {
            "token": "color.onLight"
          }
        }
      },
      "external": {
        "fill": {
          "token": "color.external"
        },
        "font": {
          "color": {
            "token": "color.onDark"
          }
        }
      },
      "cardName": {
        "font": {
          "size": 13,
          "weight": 600
        }
      },
      "cardType": {
        "font": {
          "size": 10
        },
        "opacity": 0.9
      },
      "cardDescription": {
        "font": {
          "size": 10,
          "lineHeight": 1.4
        },
        "opacity": 0.9
      },
      "boundary": {
        "fill": "none",
        "stroke": {
          "color": {
            "token": "color.muted"
          },
          "width": 1.5,
          "dash": [
            8,
            6
          ],
          "dashScale": "absolute"
        },
        "cornerRadius": 0,
        "cursor": "default"
      },
      "boundaryLabel": {
        "font": {
          "size": 11,
          "color": {
            "token": "color.muted"
          }
        }
      },
      "relationshipLabel": {
        "font": {
          "size": 10,
          "color": {
            "token": "color.muted"
          }
        }
      }
    },
    "nodes": {
      "Person": {
        "shape": "c4Person",
        "style": "person",
        "size": {
          "min": [
            160,
            39.6
          ],
          "max": [
            240,
            null
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "attribute": "name"
            },
            "editable": "inline",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                22
              ],
              "align": "center"
            },
            "style": "cardName",
            "wrap": "none",
            "overflow": "visible"
          },
          {
            "id": "type",
            "text": {
              "cel": "'[Person]'"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                38
              ],
              "align": "center"
            },
            "style": "cardType",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "description",
            "text": {
              "attribute": "description"
            },
            "editable": false,
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                58
              ],
              "align": "center"
            },
            "style": "cardDescription",
            "wrap": "word",
            "maxWidth": "parent"
          }
        ],
        "conditions": [
          {
            "when": "self.external",
            "style": "external",
            "doc": "An element outside the scope being described is muted grey, so scope is readable at a glance."
          }
        ],
        "doubleClick": "editLabel",
        "deletable": false,
        "connectable": false,
        "placement": {
          "x": "free",
          "y": "free",
          "anchor": "center",
          "resizable": false
        },
        "doc": "A rounded box with a head above it, as the c4model.com reference diagrams draw a person.",
        "tooltip": {
          "cel": "self.name + (self.description != '' ? ': ' + self.description : '')"
        },
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "self.label()"
          }
        }
      },
      "SoftwareSystem": {
        "shape": {
          "type": "roundedRect",
          "params": {
            "radius": 8
          }
        },
        "style": "softwareSystem",
        "size": {
          "min": [
            160,
            39.6
          ],
          "max": [
            240,
            null
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "attribute": "name"
            },
            "editable": "inline",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                22
              ],
              "align": "center"
            },
            "style": "cardName",
            "wrap": "none",
            "overflow": "visible"
          },
          {
            "id": "type",
            "text": {
              "cel": "'[Software System]'"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                38
              ],
              "align": "center"
            },
            "style": "cardType",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "description",
            "text": {
              "attribute": "description"
            },
            "editable": false,
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                58
              ],
              "align": "center"
            },
            "style": "cardDescription",
            "wrap": "word",
            "maxWidth": "parent"
          }
        ],
        "conditions": [
          {
            "when": "self.external",
            "style": "external",
            "doc": "An element outside the scope being described is muted grey, so scope is readable at a glance."
          }
        ],
        "variants": [
          {
            "when": "self.tags.exists(t, t.lowerAscii() == 'database')",
            "shape": "c4Cylinder",
            "doc": "An element tagged Database is drawn as a cylinder."
          }
        ],
        "deletable": false,
        "connectable": false,
        "placement": {
          "x": "free",
          "y": "free",
          "anchor": "center",
          "resizable": false
        },
        "tooltip": {
          "cel": "self.name + (self.description != '' ? ': ' + self.description : '')"
        },
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "self.label()"
          }
        }
      },
      "Container": {
        "shape": {
          "type": "roundedRect",
          "params": {
            "radius": 8
          }
        },
        "style": "container",
        "size": {
          "min": [
            160,
            39.6
          ],
          "max": [
            240,
            null
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "attribute": "name"
            },
            "editable": "inline",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                22
              ],
              "align": "center"
            },
            "style": "cardName",
            "wrap": "none",
            "overflow": "visible"
          },
          {
            "id": "type",
            "text": {
              "cel": "self.technology != '' ? '[Container: ' + self.technology + ']' : '[Container]'"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                38
              ],
              "align": "center"
            },
            "style": "cardType",
