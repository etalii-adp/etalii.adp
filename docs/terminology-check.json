{
  "$comment": "Retired uses of the ADP vocabulary (docs/terminology.md), checked by .github/scripts/terminology-check.py in every etalii-adp repository (spec 002, contracts/terminology-check.md). Words are matched case-insensitively and acronyms case-sensitively. A finding of severity 'error' fails the check; 'review' is printed for a person to judge, because 'designer' is also a valid kind.",
  "version": 1,
  "patterns": [
    {
      "id": "dedl-name",
      "regex": "\\bDEDL\\b",
      "caseSensitive": true,
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "DISL (a diagram type) or DID, the Diagram Definition Language (a stored diagram)"
    },
    {
      "id": "dedl-expansion",
      "regex": "Diagram Editor Definition",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "Diagram Specification Language (DISL) or Diagram Definition Language (DID)"
    },
    {
      "id": "dedl-extension",
      "regex": "\\.dedl\\b",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": ".dis"
    },
    {
      "id": "dedl-schema",
      "regex": "dedl\\.schema\\.json",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "disl.schema.json or did.schema.json"
    },
    {
      "id": "dedl-version-key",
      "regex": "dedlDocument|\"dedl\"\\s*:",
      "caseSensitive": true,
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "\"disl\": or \"did\":"
    },
    {
      "id": "dedl-media-type",
      "regex": "vnd\\.dedl\\.",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "vnd.disl.specification / vnd.did.definition / vnd.did.fragment"
    },
    {
      "id": "dedl-fragment",
      "regex": "dedl-fragment",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "did-fragment"
    },
    {
      "id": "dedl-paths",
      "regex": "/adp/dedl/|specifications/dedl/",
      "severity": "error",
      "entry": "DEDL is retired",
      "replacement": "/adp/disl/, specifications/disl/ or specifications/did/"
    },
    {
      "id": "draft-acronyms",
      "regex": "\\b(DIFL|DEFL|EDFL|DIDL|EDDL)\\b",
      "caseSensitive": true,
      "severity": "error",
      "entry": "earlier drafts' terms",
      "replacement": "DID, DED or EDD (definition languages); DISL, DESL or EDSL (specification languages)"
    },
    {
      "id": "draft-extensions",
      "regex": "\\.(difl|defl|edfl|didl|eddl)\\b|disl\\.disl|specifications/(didl|eddl)/",
      "severity": "error",
      "entry": "earlier drafts' terms",
      "replacement": ".did, .ded, .edd; disl.schema.json"
    },
    {
      "id": "specification-extensions",
      "regex": "(?<!\\.\\.)\\.(disl|desl|edsl)\\b(?!\\.)",
      "severity": "error",
      "entry": "a specification file holds a specification, not the language",
      "replacement": ".dis, .des, .eds"
    },
    {
      "id": "language-designer",
      "regex": "\\b(language|definition) designers?\\b",
      "severity": "error",
      "entry": "the person who specifies a tool type is a tool engineer",
      "replacement": "tool engineer(s)"
    },
    {
      "id": "author-of-definition",
      "regex": "\\bauthors?\\b",
      "severity": "review",
      "paths": [
        "specifications/**/*-specification.md",
        "docs/terminology.md"
      ],
      "entry": "the person who specifies a tool type is a tool engineer",
      "replacement": "tool engineer(s)"
    },
    {
      "id": "diagram-editor",
      "regex": "\\bdiagram editors?\\b|\\beditor runtime\\b",
      "severity": "error",
      "entry": "\"editor\" is not the running diagram or designer",
      "replacement": "diagram; runtime"
    },
    {
      "id": "mixed-copy",
      "regex": "diagram, designer and (text )?editors?|diagram and text designers|diagram, designer and editor experiences|Browse the designers",
      "severity": "error",
      "entry": "tool is the umbrella",
      "replacement": "tools: diagrams, designers and editors; Browse the tools"
    },
    {
      "id": "designer-umbrella-code",
      "regex": "DesignerEditor|offDesigners|designerSettings|ADP_DESIGNER|etalii\\.adp\\.designer\\b|DesignerInfo|DesignerOrigin|DesignersSection|DesignerState|DesignerPanel|DesignerDriver|DiagramDesigner|MindMapDesigner|createDesigner|designerInfo|DesignerPopup|DesignerCard|DesignerList|DesignerPage|RetiredDesigner",
      "caseSensitive": true,
      "severity": "error",
      "entry": "tool is the umbrella",
      "replacement": "Tool… (rename map)"
    },
    {
      "id": "designer-umbrella-prose",
      "regex": "ADP designers|the designers|designer catalogue|designer framework|Designers settings|each designer|every designer|/adp/designers/|diagram designers?\\b",
      "severity": "error",
      "entry": "tool is the umbrella",
      "replacement": "ADP tools, the tools, tool catalogue, tool framework, …"
    },
    {
      "id": "designer-word",
      "regex": "\\bdesigners?\\b",
      "severity": "review",
      "entry": "\"designer\" now means only the form-based kind",
      "replacement": "tool, or the kind that applies"
    }
  ],
  "allowedPaths": [
    "**/.git/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/build/**",
    "**/.gradle/**",
    "**/.astro/**",
    "**/out/**",
    "**/package-lock.json",
    "**/*.lock",
    "**/legacy/**",
    "**/.spec-workflow/approvals/**",
    "**/.spec-workflow/archive/**",
    "**/Implementation Logs/**",
    "**/audit.log",
    "docs/terminology.md",
    "docs/terminology-check.json",
    ".github/scripts/terminology-check.py",
    "src/content/docs/docs/terminology.mdx",
    "src/content/docs/docs/specification-and-definition.mdx"
  ],
  "allowedPathsByRepository": {
    "etalii.adp": [
      "specs/001-*/**",
      "specs/002-*/**",
      "specs/etalii.adp.ide.intellij/001-*/**",
      "specs/etalii.adp.ide.intellij/002-*/**",
      "specs/etalii.adp.ide.intellij/003-*/**",
      "specs/etalii.adp.ide.intellij/004-*/**",
      "specs/etalii.adp.site/001-*/**",
      "specs/etalii.adp.site/002-*/**",
      "specs/etalii.adp.site/003-*/**",
      "specs/etalii.adp.site/004-*/**",
      "specs/etalii.adp.site/005-*/**",
      "specs/etalii.adp.site/006-*/**",
      ".github/scripts/validate-examples.py"
    ],
    "etalii.adp.ide.intellij": [
      "core/src/test/resources/settings/baseline-adp.xml",
      "freemind/testdata/reference/spec001-test-inventory.md",
      "allure-results/**"
    ],
    "etalii.adp.site": [
      "src/data/redirects.ts",
      "tests/reference/fixtures/dedl-aaef333/**",
      "tests/reference/fixtures/disl-c2623d4/**",
      "sources/catalogue/*/diagrams.md"
    ]
  },
  "allowedLiterals": [
    {
      "text": "FileEditor",
      "reason": "IntelliJ platform API"
    },
    {
      "text": "TextEditorWithPreview",
      "reason": "IntelliJ platform API"
    },
    {
      "text": "OMG Diagram Definition",
      "reason": "third-party standard"
    },
    {
      "text": "DEDL became DISL and DID",
      "reason": "the glossary's one line of history"
    }
  ],
  "allowedSections": [
    {
      "path": "specifications/*/*-specification.md",
      "heading": "Deprecated aliases",
      "reason": "the old DEDL identifiers a runtime keeps reading (FR-011)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "src/content/reference/*/*/source/*-specification.md",
      "heading": "Deprecated aliases",
      "reason": "the site's verbatim copy of a specification's deprecated aliases (FR-011)"
    }
  ],
  "allowedLines": [
    {
      "repository": "etalii.adp",
      "path": ".specify/memory/repositories/etalii.adp.site.md",
      "regex": "reference for DEDL\\)",
      "reason": "the site constitution's amendment history, moved here with it"
    },
    {
      "path": "specifications/*/*.schema.json",
      "regex": "\"(dedl|dedlDocument)\"",
      "reason": "deprecated version key still accepted (FR-011)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "src/content/reference/*/*/source/*.schema.json",
      "regex": "\"(dedl|dedlDocument)\"",
      "reason": "the site's verbatim copy of a schema's deprecated version key (FR-011)"
    },
    {
      "repository": "etalii.adp.ide.intellij",
      "path": "core/src/main/java/etalii/adp/core/settings/AdpSettings.java",
      "regex": "offDesigners|designerSettings",
      "reason": "old settings keys still read (FR-011)"
    },
    {
      "repository": "etalii.adp.ide.intellij",
      "path": "core/src/test/java/etalii/adp/core/settings/AdpSettingsStateRoundTripTest.java",
      "regex": "offDesigners|designerSettings",
      "reason": "tests that the old settings keys are still read"
    },
    {
      "repository": "etalii.adp.site",
      "path": "src/content/reference/languages.json",
      "regex": "\"(name|short|prose|schema)\": \"(DEDL|dedl)",
      "reason": "DEDL stays registered (publish false, movedTo disl) so that its old addresses redirect and DEDL 0.1's schema keeps its address (T050)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/reference/languages.test.ts",
      "regex": "DEDL|dedl",
      "reason": "tests that DEDL stays registered and that its addresses redirect to /adp/disl/ (T050)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/catalogue.spec.ts",
      "regex": "/adp/designers/|the designer catalogue moved to /adp/tools/",
      "reason": "tests that the old /adp/designers/ addresses redirect to /adp/tools/ (T050)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "scripts/reference/check-moved.ts",
      "regex": "DEDL moved to DISL",
      "reason": "describes the check that the DEDL addresses redirect (T050)"
    },
    {
      "repository": "etalii.adp.site",
      "path": "scripts/reference/check.ts",
      "regex": "where the schema has one \\(DEDL\\)",
      "reason": "validation of the DEDL 0.1 fixture's documents in the CI compatibility build"
    },
    {
      "repository": "etalii.adp.site",
      "path": ".github/workflows/build.yml",
      "regex": "DEDL 0\\.1",
      "reason": "the CI step that builds the DEDL 0.1 fixture and checks that the old addresses redirect and its schema is still served (T050)"
    },
    {
      "repository": "etalii.adp.site",
      "path": ".specify/memory/constitution.md",
      "regex": "reference for DEDL\\)",
      "reason": "Sync Impact Report: history of the constitution's amendment"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/reference/fixture.ts",
      "regex": "DEDL-specification\\.md",
      "reason": "a file name inside the pinned DEDL 0.1 fixture"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/reference/fixtures/README.md",
      "regex": "DEDL|specifications/dedl/",
      "reason": "describes the pinned DEDL 0.1 fixture and where it came from"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/reference/split.test.ts",
      "regex": "DEDL — Diagram Editor Definition Language",
      "reason": "the title of the pinned DEDL 0.1 fixture that the prose tests read"
    },
    {
      "repository": "etalii.adp.site",
      "path": "tests/reference/visuals.test.ts",
      "regex": "(statemachine|x)\\.dedl",
      "reason": "file names of the pinned DEDL 0.1 fixture that the visual tests read"
    }
  ]
}
