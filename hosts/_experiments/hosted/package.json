{
  "name": "adp-hosted-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "buf lint src/storage/contract && buf generate && node example.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "node build.mjs",
    "check": "npm run generate && npm run typecheck && npm run build",
    "test:unit": "node test/unit/run.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "start": "node test/e2e/serve.mjs dist 8080"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.17.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/node": "22.20.7",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "preact": "11.2.0",
    "typescript": "7.0.2",
    "ws": "8.23.1",
    "yaml": "2.9.1"
  }
}
