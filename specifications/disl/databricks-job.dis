{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.2",
  "language": {
    "id": "org.example.databricks.job",
    "version": "0.1.0",
    "label": "Databricks job",
    "doc": {
      "summary": "A trimmed excerpt of the Databricks job definition (definitions/diagrams/databricks-job.dis), used to show DISL 0.2 constructs.",
      "description": "The tasks of one Databricks job and the dependencies between them, read from and written to an asset bundle. The excerpt keeps the task, missing task and job cluster types, the dependency relation, their basic notation and a small toolbox; the run simulation, the bundle YAML format, the layered layout and the plugins of the full definition are left out."
    }
  },

  "metamodel": {
    "diagram": {
      "attributes": {
        "jobKey": { "type": "string", "required": true, "readOnly": true },
        "name": { "type": "string" },
        "schedule": { "type": "string", "doc": "A Quartz cron expression." },
        "continuous": { "type": "bool", "default": false }
      }
    },
    "enums": {
      "TaskType": {
        "values": {
          "notebook": { "label": "Notebook" },
          "python": { "label": "Python" },
          "sql": { "label": "SQL" },
          "pipeline": { "label": "Pipeline" },
          "condition": { "label": "Condition" },
          "other": { "label": "Other" }
        }
      },
      "RunIf": {
        "extensible": true,
        "values": {
          "ALL_SUCCESS": { "label": "All succeeded" },
          "AT_LEAST_ONE_SUCCESS": { "label": "At least one succeeded" },
          "NONE_FAILED": { "label": "None failed" },
          "ALL_DONE": { "label": "All done" },
          "AT_LEAST_ONE_FAILED": { "label": "At least one failed" },
          "ALL_FAILED": { "label": "All failed" }
        }
      },
      "Outcome": {
        "values": {
          "true": { "label": "true", "color": "#15803d" },
          "false": { "label": "false", "color": "#dc2626" }
        }
      }
    },
    "types": {
      "Task": {
        "label": "Task",
        "labelAttribute": "key",
        "attributes": {
          "key": { "type": "string", "required": true, "key": true, "unique": "diagram", "minLength": 1 },
          "type": { "type": "TaskType", "required": true, "readOnly": true },
          "source": { "type": "string", "readOnly": true, "doc": "The notebook, script or query the task runs." },
          "clusterKey": { "type": "string" },
          "runIf": { "type": "RunIf" }
        }
      },
      "MissingTask": {
        "label": "Missing task",
        "labelAttribute": "key",
        "doc": "A task another task depends on that the job does not define.",
        "attributes": {
          "key": { "type": "string", "required": true, "key": true, "readOnly": true }
        }
      },
      "JobCluster": {
        "label": "Job cluster",
        "labelAttribute": "key",
        "attributes": {
          "key": { "type": "string", "required": true, "key": true, "readOnly": true },
          "sparkVersion": { "type": "string", "readOnly": true },
          "nodeType": { "type": "string", "readOnly": true },
          "workers": { "type": "int", "readOnly": true, "min": 0, "default": 0 }
        }
      }
    },
    "relations": {
      "Dependency": {
        "label": "Depends on",
        "source": ["Task", "MissingTask"],
        "target": "Task",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "outcome": { "type": "Outcome", "doc": "For a dependency on a condition task: the outcome it waits for." }
        }
      }
    }
  },

  "notation": {
    "styles": {
      "box": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1 },
        "cornerRadius": 4,
        "font": { "size": 13 }
      },
      "badges": { "font": { "size": 10, "color": "#5a6376" } }
    },
    "nodes": {
      "Task": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": "inline", "overflow": "ellipsis" },
          {
            "id": "badges",
            "text": { "cel": "(has(self.runIf) ? self.runIf + ' · ' : '') + (has(self.clusterKey) && self.clusterKey != '' ? self.clusterKey : 'serverless')" },
            "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" },
            "editable": false,
            "style": "badges"
          }
        ],
        "anchors": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 }, { "id": "right", "x": 1, "y": 0.5 } ] },
        "variants": [ { "when": "self.type == 'condition'", "style": { "cornerRadius": 16 } } ]
      },
      "MissingTask": {
        "shape": "rect",
        "style": { "extends": "box", "fill": "transparent", "opacity": 0.7, "stroke": { "dash": [5, 4] } },
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" }
        ],
        "connectable": false
      },
      "JobCluster": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          {
            "id": "badges",
            "text": { "cel": "[self.sparkVersion, self.nodeType, self.workers > 0 ? string(self.workers) + ' workers' : ''].filter(b, b != '').join(' · ')" },
            "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" },
            "style": "badges"
          }
        ],
        "connectable": false
      }
    },
    "edges": {
      "Dependency": {
        "line": {
          "stroke": { "color": { "token": "color.border" }, "width": 1.5 },
          "routing": "bezier",
          "startDirection": "right",
          "endDirection": "left"
        },
        "targetMarker": "arrow",
        "labels": [
          { "id": "outcome", "text": { "cel": "has(self.outcome) ? self.outcome : ''" }, "at": "middle", "offset": -6, "editable": false }
        ],
        "conditions": [
          { "when": "has(self.outcome) && self.outcome == 'true'", "style": { "stroke": { "color": "#15803d" } } },
          { "when": "has(self.outcome) && self.outcome == 'false'", "style": { "stroke": { "color": "#dc2626" } } }
        ]
      }
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      {
        "id": "tasks",
        "label": "Tasks",
        "tools": [
          { "id": "notebookTask", "label": "Notebook task", "creates": "Task", "mode": "click", "initial": { "type": "'notebook'", "key": "'notebook_' + string(diagram.nodesOfType('Task').filter(t, t.type == 'notebook').size() + 1)" } },
          { "id": "pythonTask", "label": "Python task", "creates": "Task", "mode": "click", "initial": { "type": "'python'", "key": "'python_' + string(diagram.nodesOfType('Task').filter(t, t.type == 'python').size() + 1)" } },
          { "id": "conditionTask", "label": "Condition task", "creates": "Task", "mode": "click", "initial": { "type": "'condition'", "key": "'condition_' + string(diagram.nodesOfType('Task').filter(t, t.type == 'condition').size() + 1)" } },
          { "id": "dependency", "label": "Dependency", "creates": "Dependency", "mode": "drag" }
        ]
      }
    ]
  }
}
